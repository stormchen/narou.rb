:ruby
  html = HTML.new

:css
  .indent {
    margin-left: 2em;
    margin-right: 2em;
  }

= partial :header

.container
  %h1= @data["title"]
  %ul
    %li
      前言出現率
      = @introductions_ratio
      \%
    %li
      後記出現率
      = @postscripts_ratio
      \%
    %li
      %a{ href: "./setting#enable_author_comments" }
        前往前言／後記刪除設定

  %table.table.table-striped
    - @comments.each do |comment|
      %tr
        %td
          %dl
            %dd= comment[:sub]["subtitle"]

            %dt 前言
            %dd.indent= html.ln_to_br(comment[:introduction])

            %dt 後記
            %dd.indent= html.ln_to_br(comment[:postscript])
