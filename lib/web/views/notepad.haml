:javascript
  local_initialize_functions.push(function($) {
    $("[data-toggle=tooltip]").tooltip({
      animation: false,
      container: "body",
    });

    Narou.Notepad.replace("notepad");
  });

= partial :header

.container.theme-showcase(role="main")
  %h1 便簽記事本
  %ul.text-muted
    %li 編輯內容將會自動儲存至伺服器
    %li 若在其他瀏覽器分頁開啟，內容也會即時同步
  .row
    .col-sm-9
      #notepad
