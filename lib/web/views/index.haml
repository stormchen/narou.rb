.container.container-main.theme-showcase(role="main")
  -# 初めて表示した時のメッセージ
  - if @is_first_access
    .alert.alert-info.fade.in(role="alert")
      %button.close(type="button" data-dismiss="alert")
        %span(aria-hidden="true") &times;
        %span.sr-only Close
      %h2 歡迎使用 Narou.rb WEB UI
      %p 請先參閱說明以了解簡易操作。本提示僅於首次造訪時顯示。
      %p(style="margin-top:20px")
        %a.btn.btn-primary(href="/help" role="button") 查看說明 &raquo;

  -# コンソール
  #console-container
    - console_stdout = capture_haml do
      #console.console
      #console-buttons.console-buttons
        %span.queue-cancel.glyphicon.glyphicon-remove-circle(data-toggle="tooltip" title="中斷處理")
        %span.console-history.glyphicon.glyphicon-cloud-download(data-toggle="tooltip" title="取得全部歷程")
        %span.console-trash.glyphicon.glyphicon-trash(data-toggle="tooltip" title="清除畫面與歷程")
        %span.console-expand
          %span.glyphicon.glyphicon-resize-full(data-toggle="tooltip" title="放大")
          %span.glyphicon.glyphicon-resize-small.hide(data-toggle="tooltip" title="縮小")
    - if Narou.concurrency_enabled?
      .row
        .col-xs-7.console-col-left
          = console_stdout
        .col-xs-5.console-col-right
          #console-stdout2.console
    - else
      = console_stdout

  -# 操作パネル
  #control-panel
    .control-panel-inner
      .btn-group
        %button.button-download.btn.btn-primary(type="button" data-toggle="tooltip" |
                                title="下載新小說") Download |
        %button.btn.btn-primary.dropdown-toggle(type="button" data-toggle="dropdown")
          %span.caret
          %span.sr-only Toggle Dropdown
        %ul.dropdown-menu(role="menu")
          %li
            %a.button-download-force(href="#") 強制重新下載所選小說
      .btn-group
        %button.button-update.btn.btn-success(type="button" data-toggle="tooltip") Update
        %button.btn.btn-success.dropdown-toggle(type="button" data-toggle="dropdown")
          %span.caret
          %span.sr-only Toggle Dropdown
        %ul.dropdown-menu(role="menu")
          %li
            %a.button-update-general-lastup(href="#") 檢查最新話發表日
          %li
            %a.button-update-by-tag(href="#") 依標籤更新小說
          %li
            %a.button-update-view(href="#") 更新目前顯示的小說
          %li
            %a.button-update-force(href="#") 已凍結小說亦執行更新
      .btn-group
        %button.button-update-general-lastup-narou.btn.btn-success(type="button" data-toggle="tooltip" title="透過成為小說家吧 API 檢查最新話")
          な
        %button.button-update-general-lastup-other.btn.btn-success(type="button" data-toggle="tooltip" title="檢查其他小說最新話發表日")
          他
        %button.button-update-general-lastup-update-modified.btn.btn-success(type="button" data-toggle="tooltip" title="更新帶有 modified 標籤的小說")
          %span.glyphicon.glyphicon-refresh
      .btn-group
        %button.button-send.btn.btn-warning(type="button" data-toggle="tooltip") Send
        :ruby
          menus = []
          if Inventory.load["hotentry"]
            menus << ["button-send-hotentry", "傳送 hotentry"]
          end
          if Inventory.load["device"] == "kindle"
            menus << ["button-send-backup-bookmark", "備份裝置書籤資料"]
          end
        - unless menus.empty?
          %button.btn.btn-warning.dropdown-toggle(type="button" data-toggle="dropdown")
            %span.caret
            %span.sr-only Toggle Dropdown
          %ul.dropdown-menu(role="menu")
            - menus.each do |klass, label|
              %li
                %a{ href: "#", class: klass }= label
      .btn-group
        %button.btn.btn-info.dropdown-toggle.enable-selected(type="button" data-toggle="dropdown")
          Freeze
          %span.caret
          %span.sr-only Toggle Dropdown
        %ul.dropdown-menu(role="menu")
          %li
            %a.button-freeze-on(href="#") 凍結所選小說
          %li
            %a.button-freeze-off(href="#") 解除所選小說凍結
      .btn-group
        %button.button-remove.btn.btn-danger.enable-selected(type="button" data-toggle="tooltip" |
                              title="刪除所選小說") Remove |
      .btn-group
        %button.button-convert.btn.btn-default.enable-selected(type="button" data-toggle="tooltip" |
                              title="轉換所選小說") Convert |
      .btn-group
        %button.btn.btn-default.dropdown-toggle.enable-selected(type="button" data-toggle="dropdown")
          Other
          %span.caret
          %span.sr-only Toggle Dropdown
        %ul.dropdown-menu(role="menu")
          %li
            %a.button-diff(href="#") 顯示所選小說最新差異
          %li
            %a.button-inspect(href="#") 顯示所選小說調查日誌
          %li
            %a.button-folder(href="#") 開啟所選小說儲存資料夾
          %li
            %a.button-backup(href="#") 建立所選小說備份
          %li
            %a.button-setting-burn(href="#") 將通用設定寫入所選小說的未設定項目
          %li
            %a.button-mail(href="#") 以電子郵件傳送所選小說
      .btn-group.eject-group.hide
        %button.button-eject.btn.btn-default(type="button" data-toggle="tooltip" title="退出裝置")
          Eject
        %button.btn.btn-default.dropdown-toggle(type="button" data-toggle="dropdown")
          %span.caret
          %span.sr-only Toggle Dropdown
        %ul.dropdown-menu(role="menu")
          %li
            %a.button-eject-now(href="#") 立即退出裝置

